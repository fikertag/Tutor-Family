"use client";
import * as React from "react";
import { Card } from "@/components/ui/card";
import { useEffect, type ChangeEvent } from "react";
import { useQuery, useMutation } from "@tanstack/react-query";
import { useUserStore } from "@/store/user_store";
import { authClient } from "@/lib/auth-client";
import { useTutorProfile } from "@/hooks/useTutors";

export default function Page() {
  const { data: profiles, isLoading: loadingProfile } = useTutorProfile();

  useEffect(() => {
    console.log("profiles", profiles);
    console.log("loadingProfile", loadingProfile);
  }, [profiles, loadingProfile]);

  // Demo data for profile, availability, qualifications, education, experience
  const [profile, setProfile] = React.useState({
    user: {
      first_name: "Elsa",
      last_name: "Mengistu",
      email: "arifayusuf00@gmail.com",
      phone: "+251912345678",
      gender: "MALE",
      profile_picture_url: null,
      profile_picture_local_path: "",
    },
    location: "Addis Ababa",
    snapshot_bio:
      "Experienced tutor with a strong background in STEM subjects.",
    hourly_rate: 30,
    languages: ["English", "Amharic"],
  });
  const [editingProfile, setEditingProfile] = React.useState(false);
  const [profileForm, setProfileForm] = React.useState(profile);

  const [availabilities, setAvailabilities] = React.useState([
    { id: "1", weekday: "Monday", time: "10:00-12:00" },
    { id: "2", weekday: "Wednesday", time: "14:00-16:00" },
  ]);
  const [editingAvailId, setEditingAvailId] = React.useState<string | null>(
    null
  );
  const [availForm, setAvailForm] = React.useState({ weekday: "", time: "" });

  const [qualifications, setQualifications] = React.useState([
    {
      id: "1",
      certificate_name: "Certified Tutor Training",
      issuing_organization: "Tutors Ethiopia",
      date_issued: "2023-07-01",
    },
  ]);
  const [editingQualId, setEditingQualId] = React.useState<string | null>(null);
  const [qualForm, setQualForm] = React.useState({
    certificate_name: "",
    issuing_organization: "",
    date_issued: "",
  });

  const [educations, setEducations] = React.useState([
    {
      id: "1",
      institution_name: "ASTU",
      degree: "BSc in Physics",
      field_of_study: "Physics",
      start_date: "2018-09-01",
      end_date: "2022-07-01",
    },
  ]);
  const [editingEduId, setEditingEduId] = React.useState<string | null>(null);
  const [eduForm, setEduForm] = React.useState({
    institution_name: "",
    degree: "",
    field_of_study: "",
    start_date: "",
    end_date: "",
  });

  const [experiences, setExperiences] = React.useState([
    {
      id: "1",
      title: "Private Tutor",
      company: "Self-employed",
      start_date: "2020-01-01",
      end_date: "2023-01-01",
    },
  ]);
  const [editingExpId, setEditingExpId] = React.useState<string | null>(null);
  const [expForm, setExpForm] = React.useState({
    title: "",
    company: "",
    start_date: "",
    end_date: "",
  });

  // Handlers for profile
  function handleProfileEdit() {
    setProfileForm(profile);
    setEditingProfile(true);
  }
  function handleProfileFormChange(
    e: ChangeEvent<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>
  ) {
    const { name, value } = e.target;
    if (name.startsWith("user.")) {
      setProfileForm((prev) => ({
        ...prev,
        user: { ...prev.user, [name.replace("user.", "")]: value },
      }));
    } else if (name === "languages") {
      setProfileForm((prev) => ({ ...prev, languages: value.split(",") }));
    } else {
      setProfileForm((prev) => ({ ...prev, [name]: value }));
    }
  }
  function handleProfileSave() {
    setProfile(profileForm);
    setEditingProfile(false);
  }
  function handleProfileCancel() {
    setEditingProfile(false);
  }

  // Handlers for availability
  function handleAvailEdit(a: { id: string; weekday: string; time: string }) {
    setAvailForm({ weekday: a.weekday, time: a.time });
    setEditingAvailId(a.id);
  }
  function handleAvailFormChange(
    e: ChangeEvent<HTMLInputElement | HTMLSelectElement>
  ) {
    setAvailForm((prev) => ({ ...prev, [e.target.name]: e.target.value }));
  }
  function handleAvailSave(id: string) {
    setAvailabilities((prev) =>
      prev.map((a) => (a.id === id ? { ...a, ...availForm } : a))
    );
    setEditingAvailId(null);
  }
  function handleAvailCancel() {
    setEditingAvailId(null);
  }

  // Handlers for qualifications
  function handleQualEdit(q: {
    id: string;
    certificate_name: string;
    issuing_organization: string;
    date_issued: string;
  }) {
    setQualForm({
      certificate_name: q.certificate_name,
      issuing_organization: q.issuing_organization,
      date_issued: q.date_issued,
    });
    setEditingQualId(q.id);
  }
  function handleQualFormChange(e: ChangeEvent<HTMLInputElement>) {
    setQualForm((prev) => ({ ...prev, [e.target.name]: e.target.value }));
  }
  function handleQualSave(id: string) {
    setQualifications((prev) =>
      prev.map((q) => (q.id === id ? { ...q, ...qualForm } : q))
    );
    setEditingQualId(null);
  }
  function handleQualCancel() {
    setEditingQualId(null);
  }

  // Handlers for education
  function handleEduEdit(e: {
    id: string;
    institution_name: string;
    degree: string;
    field_of_study: string;
    start_date: string;
    end_date: string;
  }) {
    setEduForm({
      institution_name: e.institution_name,
      degree: e.degree,
      field_of_study: e.field_of_study,
      start_date: e.start_date,
      end_date: e.end_date,
    });
    setEditingEduId(e.id);
  }
  function handleEduFormChange(e: ChangeEvent<HTMLInputElement>) {
    setEduForm((prev) => ({ ...prev, [e.target.name]: e.target.value }));
  }
  function handleEduSave(id: string) {
    setEducations((prev) =>
      prev.map((ed) => (ed.id === id ? { ...ed, ...eduForm } : ed))
    );
    setEditingEduId(null);
  }
  function handleEduCancel() {
    setEditingEduId(null);
  }

  // Handlers for experience
  function handleExpEdit(ex: {
    id: string;
    title: string;
    company: string;
    start_date: string;
    end_date: string;
  }) {
    setExpForm({
      title: ex.title,
      company: ex.company,
      start_date: ex.start_date,
      end_date: ex.end_date,
    });
    setEditingExpId(ex.id);
  }
  function handleExpFormChange(e: ChangeEvent<HTMLInputElement>) {
    setExpForm((prev) => ({ ...prev, [e.target.name]: e.target.value }));
  }
  function handleExpSave(id: string) {
    setExperiences((prev) =>
      prev.map((ex) => (ex.id === id ? { ...ex, ...expForm } : ex))
    );
    setEditingExpId(null);
  }
  function handleExpCancel() {
    setEditingExpId(null);
  }

  return (
    <div className="max-w-2xl mx-auto">
      <h1 className="text-2xl font-bold mb-6">Profile</h1>
      {/* Profile Section */}
      <Card className="p-6 mb-10">
        <div className="flex justify-between items-center mb-2">
          <h2 className="text-xl font-semibold">Personal Info</h2>
          {!editingProfile && (
            <button
              className="text-primary underline"
              onClick={handleProfileEdit}
            >
              Edit
            </button>
          )}
        </div>
        {editingProfile ? (
          <div className="space-y-4">
            <div className="grid grid-cols-2 gap-4">
              <input
                name="user.first_name"
                value={profileForm.user.first_name}
                onChange={handleProfileFormChange}
                className="border rounded px-2 py-1"
                placeholder="First Name"
              />
              <input
                name="user.last_name"
                value={profileForm.user.last_name}
                onChange={handleProfileFormChange}
                className="border rounded px-2 py-1"
                placeholder="Last Name"
              />
            </div>
            <div className="grid grid-cols-2 gap-4">
              <input
                name="user.email"
                value={profileForm.user.email}
                onChange={handleProfileFormChange}
                className="border rounded px-2 py-1"
                placeholder="Email"
                disabled
              />
              <input
                name="user.phone"
                value={profileForm.user.phone}
                onChange={handleProfileFormChange}
                className="border rounded px-2 py-1"
                placeholder="Phone"
              />
            </div>
            <div className="grid grid-cols-2 gap-4">
              <select
                name="user.gender"
                value={profileForm.user.gender}
                onChange={handleProfileFormChange}
                className="border rounded px-2 py-1"
              >
                <option value="MALE">Male</option>
                <option value="FEMALE">Female</option>
                <option value="OTHER">Other</option>
              </select>
              <input
                name="location"
                value={profileForm.location}
                onChange={handleProfileFormChange}
                className="border rounded px-2 py-1"
                placeholder="Location"
              />
            </div>
            <input
              name="languages"
              value={profileForm.languages.join(", ")}
              onChange={handleProfileFormChange}
              className="border rounded px-2 py-1"
              placeholder="Languages (comma separated)"
            />
            <input
              name="hourly_rate"
              type="number"
              value={profileForm.hourly_rate}
              onChange={handleProfileFormChange}
              className="border rounded px-2 py-1"
              placeholder="Hourly Rate"
            />
            <textarea
              name="snapshot_bio"
              value={profileForm.snapshot_bio}
              onChange={handleProfileFormChange}
              className="border rounded px-2 py-1 w-full"
              placeholder="Short Bio"
            />
            <div className="flex gap-2 mt-2">
              <button
                className="bg-primary text-white px-4 py-1 rounded"
                onClick={handleProfileSave}
              >
                Save
              </button>
              <button
                className="text-muted-foreground"
                onClick={handleProfileCancel}
              >
                Cancel
              </button>
            </div>
          </div>
        ) : (
          <div className="space-y-2">
            <div>
              <span className="font-medium">Name:</span>{" "}
              {profile.user.first_name} {profile.user.last_name}
            </div>
            <div>
              <span className="font-medium">Email:</span> {profile.user.email}
            </div>
            <div>
              <span className="font-medium">Phone:</span> {profile.user.phone}
            </div>
            <div>
              <span className="font-medium">Gender:</span> {profile.user.gender}
            </div>
            <div>
              <span className="font-medium">Location:</span> {profile.location}
            </div>
            <div>
              <span className="font-medium">Languages:</span>{" "}
              {profile.languages.join(", ")}
            </div>
            <div>
              <span className="font-medium">Hourly Rate:</span> $
              {profile.hourly_rate}
            </div>
            <div>
              <span className="font-medium">Short Bio:</span>{" "}
              {profile.snapshot_bio}
            </div>
          </div>
        )}
      </Card>
      {/* Availability Section */}
      <Card className="p-6 mb-10">
        <div className="flex justify-between items-center mb-2">
          <h2 className="text-xl font-semibold">Availability</h2>
        </div>
        <ul className="space-y-4">
          {availabilities.map((a) => (
            <li key={a.id} className="flex items-center gap-4">
              {editingAvailId === a.id ? (
                <>
                  <select
                    name="weekday"
                    value={availForm.weekday}
                    onChange={handleAvailFormChange}
                    className="border rounded px-2 py-1"
                  >
                    <option>Monday</option>
                    <option>Tuesday</option>
                    <option>Wednesday</option>
                    <option>Thursday</option>
                    <option>Friday</option>
                    <option>Saturday</option>
                    <option>Sunday</option>
                  </select>
                  <input
                    name="time"
                    value={availForm.time}
                    onChange={handleAvailFormChange}
                    className="border rounded px-2 py-1 w-32"
                    placeholder="e.g. 10:00-12:00"
                  />
                  <button
                    className="bg-primary text-white px-3 py-1 rounded ml-2"
                    onClick={() => handleAvailSave(a.id)}
                  >
                    Save
                  </button>
                  <button
                    className="ml-2 text-muted-foreground"
                    onClick={handleAvailCancel}
                  >
                    Cancel
                  </button>
                </>
              ) : (
                <>
                  <span className="font-medium">{a.weekday}</span>
                  <span className="text-muted-foreground">{a.time}</span>
                  <button
                    className="ml-4 text-primary underline"
                    onClick={() => handleAvailEdit(a)}
                  >
                    Edit
                  </button>
                </>
              )}
            </li>
          ))}
        </ul>
      </Card>
      {/* Qualifications Section */}
      <Card className="p-6 mb-10">
        <div className="flex justify-between items-center mb-2">
          <h2 className="text-xl font-semibold">Qualifications</h2>
        </div>
        <ul className="space-y-4">
          {qualifications.map((q) => (
            <li key={q.id} className="flex items-center gap-4">
              {editingQualId === q.id ? (
                <>
                  <input
                    name="certificate_name"
                    value={qualForm.certificate_name}
                    onChange={handleQualFormChange}
                    className="border rounded px-2 py-1"
                    placeholder="Certificate Name"
                  />
                  <input
                    name="issuing_organization"
                    value={qualForm.issuing_organization}
                    onChange={handleQualFormChange}
                    className="border rounded px-2 py-1"
                    placeholder="Organization"
                  />
                  <input
                    name="date_issued"
                    value={qualForm.date_issued}
                    onChange={handleQualFormChange}
                    className="border rounded px-2 py-1"
                    placeholder="YYYY-MM-DD"
                  />
                  <button
                    className="bg-primary text-white px-3 py-1 rounded ml-2"
                    onClick={() => handleQualSave(q.id)}
                  >
                    Save
                  </button>
                  <button
                    className="ml-2 text-muted-foreground"
                    onClick={handleQualCancel}
                  >
                    Cancel
                  </button>
                </>
              ) : (
                <>
                  <span className="font-medium">{q.certificate_name}</span>
                  <span className="text-muted-foreground">
                    {q.issuing_organization}
                  </span>
                  <span className="text-muted-foreground">{q.date_issued}</span>
                  <button
                    className="ml-4 text-primary underline"
                    onClick={() => handleQualEdit(q)}
                  >
                    Edit
                  </button>
                </>
              )}
            </li>
          ))}
        </ul>
      </Card>
      {/* Education Section */}
      <Card className="p-6 mb-10">
        <div className="flex justify-between items-center mb-2">
          <h2 className="text-xl font-semibold">Education</h2>
        </div>
        <ul className="space-y-4">
          {educations.map((e) => (
            <li key={e.id} className="flex items-center gap-4">
              {editingEduId === e.id ? (
                <>
                  <input
                    name="institution_name"
                    value={eduForm.institution_name}
                    onChange={handleEduFormChange}
                    className="border rounded px-2 py-1"
                    placeholder="Institution"
                  />
                  <input
                    name="degree"
                    value={eduForm.degree}
                    onChange={handleEduFormChange}
                    className="border rounded px-2 py-1"
                    placeholder="Degree"
                  />
                  <input
                    name="field_of_study"
                    value={eduForm.field_of_study}
                    onChange={handleEduFormChange}
                    className="border rounded px-2 py-1"
                    placeholder="Field"
                  />
                  <input
                    name="start_date"
                    value={eduForm.start_date}
                    onChange={handleEduFormChange}
                    className="border rounded px-2 py-1"
                    placeholder="Start Date"
                  />
                  <input
                    name="end_date"
                    value={eduForm.end_date}
                    onChange={handleEduFormChange}
                    className="border rounded px-2 py-1"
                    placeholder="End Date"
                  />
                  <button
                    className="bg-primary text-white px-3 py-1 rounded ml-2"
                    onClick={() => handleEduSave(e.id)}
                  >
                    Save
                  </button>
                  <button
                    className="ml-2 text-muted-foreground"
                    onClick={handleEduCancel}
                  >
                    Cancel
                  </button>
                </>
              ) : (
                <>
                  <span className="font-medium">{e.degree}</span>
                  <span className="text-muted-foreground">
                    {e.field_of_study}
                  </span>
                  <span className="text-muted-foreground">
                    {e.institution_name}
                  </span>
                  <span className="text-muted-foreground">
                    {e.start_date} - {e.end_date}
                  </span>
                  <button
                    className="ml-4 text-primary underline"
                    onClick={() => handleEduEdit(e)}
                  >
                    Edit
                  </button>
                </>
              )}
            </li>
          ))}
        </ul>
      </Card>
      {/* Experience Section */}
      <Card className="p-6 mb-10">
        <div className="flex justify-between items-center mb-2">
          <h2 className="text-xl font-semibold">Experience</h2>
        </div>
        <ul className="space-y-4">
          {experiences.map((ex) => (
            <li key={ex.id} className="flex items-center gap-4">
              {editingExpId === ex.id ? (
                <>
                  <input
                    name="title"
                    value={expForm.title}
                    onChange={handleExpFormChange}
                    className="border rounded px-2 py-1"
                    placeholder="Title"
                  />
                  <input
                    name="company"
                    value={expForm.company}
                    onChange={handleExpFormChange}
                    className="border rounded px-2 py-1"
                    placeholder="Company"
                  />
                  <input
                    name="start_date"
                    value={expForm.start_date}
                    onChange={handleExpFormChange}
                    className="border rounded px-2 py-1"
                    placeholder="Start Date"
                  />
                  <input
                    name="end_date"
                    value={expForm.end_date}
                    onChange={handleExpFormChange}
                    className="border rounded px-2 py-1"
                    placeholder="End Date"
                  />
                  <button
                    className="bg-primary text-white px-3 py-1 rounded ml-2"
                    onClick={() => handleExpSave(ex.id)}
                  >
                    Save
                  </button>
                  <button
                    className="ml-2 text-muted-foreground"
                    onClick={handleExpCancel}
                  >
                    Cancel
                  </button>
                </>
              ) : (
                <>
                  <span className="font-medium">{ex.title}</span>
                  <span className="text-muted-foreground">{ex.company}</span>
                  <span className="text-muted-foreground">
                    {ex.start_date} - {ex.end_date}
                  </span>
                  <button
                    className="ml-4 text-primary underline"
                    onClick={() => handleExpEdit(ex)}
                  >
                    Edit
                  </button>
                </>
              )}
            </li>
          ))}
        </ul>
      </Card>
      {/* Verification Section (read-only) */}
      <Card className="p-6 mb-10">
        <h2 className="text-xl font-semibold mb-4">Verification</h2>
        <div className="text-muted-foreground">
          <div>Status: PENDING</div>
          <div>Country: Ethiopia</div>
          <div>National ID: ET14566</div>
        </div>
      </Card>
    </div>
  );
}
